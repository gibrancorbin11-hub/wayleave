{
  "name": "wayleave",
  "version": "0.5.0",
  "description": "Know which AI agents cross your API — verified by signature, not guessed from an IP. Sorts every request into four lanes, prices the non-human ones with HTTP 402, and never charges a human. Zero dependencies.",
  "type": "module",
  "main": "index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./meter": {
      "types": "./meter.d.ts",
      "default": "./meter.js"
    },
    "./x402": {
      "types": "./x402.d.ts",
      "default": "./x402.js"
    },
    "./policy": {
      "types": "./policy.d.ts",
      "default": "./policy.js"
    },
    "./registry": {
      "default": "./registry.js"
    },
    "./manifest": {
      "default": "./manifest.js"
    }
  },
  "files": [
    "LICENSE",
    "README.md",
    "cdp-auth.js",
    "index.d.ts",
    "index.js",
    "manifest.js",
    "meter.d.ts",
    "meter.js",
    "policy-engine.js",
    "policy.d.ts",
    "policy.js",
    "registry.js",
    "x402.d.ts",
    "x402.js"
  ],
  "scripts": {
    "test": "node --test --test-timeout=60000 *.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "ai-agents",
    "agent-identity",
    "agent-traffic",
    "bot-detection",
    "web-bot-auth",
    "rfc9421",
    "http-message-signatures",
    "ed25519",
    "402",
    "http-402",
    "x402",
    "agent-payments",
    "micropayments",
    "middleware",
    "express",
    "connect",
    "api-monetization",
    "monetization",
    "rate-limiting",
    "access-control",
    "zero-dependencies"
  ],
  "license": "MIT",
  "author": "Gibran Corbin (https://github.com/gibrancorbin11-hub)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gibrancorbin11-hub/wayleave.git"
  },
  "bugs": {
    "url": "https://github.com/gibrancorbin11-hub/wayleave/issues"
  },
  "homepage": "https://wayleave.dev"
}
